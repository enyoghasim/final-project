    "@resvg/resvg-js": "^2.6.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.16",
    "openai": "^4.68.4",
