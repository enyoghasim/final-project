# apps/api/.env
PORT=4000
MONGODB_URI=mongodb://localhost:27017/resume-ai
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173
# Public signup is closed by default; set to "false" to allow self-service signup.
DISABLE_SIGNUP=true

# S3-compatible object storage (MinIO) for uploaded resume files, backing the
# "download resume" link on shared evaluations.
S3_ENDPOINT=http://localhost:9000
# Only set this when the API reaches storage over a different address than a
# browser would (e.g. an internal Docker hostname in prod) — presigned
# download links are signed against this one so browsers can follow them.
# S3_PUBLIC_ENDPOINT=https://minio.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resume-ai
S3_FORCE_PATH_STYLE=true

# Backs the public share-link rate limiter and the view-count/OG-image cache.
REDIS_URL=redis://localhost:6379

# Public origin of the web app; used to build absolute share/OG links.
# Falls back to the first CORS_ORIGIN entry when unset.
WEB_PUBLIC_URL=http://localhost:5173

# apps/web/.env
VITE_API_BASE_URL=http://localhost:4000

# apps/web (Docker runtime env, not build-time — see apps/web/Dockerfile)
# The API's address as reached FROM the web container (for proxying
# per-evaluation share-link previews to crawlers), not from the browser.
API_INTERNAL_URL=http://api:4000
